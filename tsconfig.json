{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@pptx-editor.dev/i18n": ["./packages/i18n/src/index.ts"],
      "@pptx-editor.dev/core/*": ["./packages/core/src/*/index.ts"],
      "@pptx-editor.dev/pro/drawing": ["./packages/pro/src/drawing/index.ts"],
      "@pptx-editor.dev/pptx-to-pdf": ["./packages/pptx-to-pdf/src/index.ts"]
    }
  },
  "include": ["api/**/*.ts", "packages/pptx-to-pdf/src/fontkit.d.ts", "scripts/**/*.ts", "e2e/**/*.ts", "docs/site/data/*.ts"]
}
