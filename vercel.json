{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build:pdf && bun run build:preview",
  "outputDirectory": "examples/parity/dist",
  "installCommand": "HUSKY=0 bun install --frozen-lockfile",
  "functions": {
    "api/convert.ts": {
      "maxDuration": 120,
      "memory": 2048,
      "includeFiles": "{packages/core/dist/harfbuzz.wasm,node_modules/.bun/@docx-editor.dev+fonts*/node_modules/@docx-editor.dev/*/assets/**}"
    }
  },
  "rewrites": [
    { "source": "/react/(.*)", "destination": "/react/index.html" },
    { "source": "/vue/(.*)", "destination": "/vue/index.html" },
    { "source": "/", "destination": "/react/index.html" }
  ]
}
