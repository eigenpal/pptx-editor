{
  "name": "@pptx-editor.dev/react",
  "version": "0.5.0",
  "description": "React adapter for PPTX Editor: a provider, hooks, and chrome compounds over the @pptx-editor.dev/core editor contract.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @pptx-editor.dev/react --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @pptx-editor.dev/react"
  },
  "dependencies": {
    "@pptx-editor.dev/i18n": "^0.5.0"
  },
  "peerDependencies": {
    "@pptx-editor.dev/core": "~0.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@pptx-editor.dev/core": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/pptx-editor.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
