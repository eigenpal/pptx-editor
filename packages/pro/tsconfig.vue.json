{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@pptx-editor.dev/core": ["../core/src/index.ts"],
      "@pptx-editor.dev/core/*": ["../core/src/*/index.ts"],
      "@pptx-editor.dev/i18n": ["../i18n/src/index.ts"],
      "@pptx-editor.dev/vue": ["../vue/src/index.ts"],
      "@eigenpal/ooxml-core": ["../ooxml-core/src/index.ts"]
    }
  },
  // Every Vue file of the package: `tsconfig.json` compiles JSX for React.
  "include": ["src/vue"]
}
