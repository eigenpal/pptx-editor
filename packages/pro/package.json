{
  "name": "@pptx-editor.dev/pro",
  "version": "0.3.1",
  "description": "Commercial capabilities for PPTX Editor, as EditorModules: the review module with the comments pane and review hooks for React and Vue, realtime collaboration, and advanced drawing rendering (charts, glow, inner shadow, reflection, and soft edge).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drawing": {
      "types": "./dist/drawing.d.ts",
      "import": "./dist/drawing.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vue.json",
    "api:extract": "node ../../scripts/api-extractor.mjs --package @pptx-editor.dev/pro --local",
    "api:check": "node ../../scripts/api-extractor.mjs --package @pptx-editor.dev/pro"
  },
  "peerDependencies": {
    "@pptx-editor.dev/core": "~0.3.0",
    "@pptx-editor.dev/react": "~0.3.0",
    "@pptx-editor.dev/vue": "~0.3.0",
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@pptx-editor.dev/react": {
      "optional": true
    },
    "@pptx-editor.dev/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pptx-editor.dev/core": "workspace:*",
    "@pptx-editor.dev/i18n": "workspace:*",
    "@pptx-editor.dev/react": "workspace:*",
    "@pptx-editor.dev/vue": "workspace:*",
    "vue": "3.5.44"
  },
  "license": "LicenseRef-EigenPal-Pro-Evaluation-1.0",
  "dependencies": {
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eigenpal/pptx-editor.git",
    "directory": "packages/pro"
  },
  "publishConfig": {
    "access": "public"
  }
}
