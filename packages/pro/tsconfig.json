{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@pptx-editor.dev/core": ["../core/src/index.ts"],
      "@pptx-editor.dev/core/*": ["../core/src/*/index.ts"],
      "@pptx-editor.dev/i18n": ["../i18n/src/index.ts"],
      "@pptx-editor.dev/react": ["../react/src/index.ts"],
      // For `bun test`, which reads this file only. The React program never imports it.
      "@pptx-editor.dev/vue": ["../vue/src/index.ts"],
      "@eigenpal/ooxml-core": ["../ooxml-core/src/index.ts"]
    }
  },
  "include": ["src"],
  // The Vue entry compiles its JSX for Vue, in `tsconfig.vue.json`; this program compiles JSX
  // for React, as in DOCX Editor's pro package.
  "exclude": ["src/vue"]
}
