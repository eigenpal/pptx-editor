  "omissions": [
    {
      "uid": "OfficeExtension.ClientRequestContext#requestHeaders",
      "reason": "The HTTP headers of the requests from an add-in to its host. A runtime calls its presentation host in the same process and sends no HTTP request, so a header would have no effect, and a property that accepts headers and ignores them would hide that."
    },
    {
      "uid": "PowerPoint.RequestContext#sensitivityLabelsCatalog",
      "reason": "The catalog of labels comes from the compliance service of the signed-in user's organization, through the host. It is not in the file, and a runtime has no user, no organization, and no service to ask."
    },
    {
      "uid": "PowerPoint.createPresentation",
      "reason": "Opens a new presentation in a new host window. Host window management is outside the presentation object model; a host opens a deck through its own runtime factory."
    }
  ],
  "conformanceExceptions": [
    {
      "uid": "PowerPoint.run",
      "reason": "The package has no global host to run against, so it exports no top-level run function. PptxEditorRuntime#run takes the same batch callback and the same object or object-array first argument. The source-compatibility fixtures call it in place of PowerPoint.run."
    },
    {
      "uid": "OfficeExtension.ClientRequestContext#load",
      "reason": "The package returns the object it loads, typed as that object (load<T extends ClientObject>(object: T, option?: LoadOption): T), so a call can chain; Office.js returns void. Every Office.js call compiles, because LoadOption already takes a string and a string array, and a void result is not used."
    },
    {
      "uid": "OfficeExtension.ClientRequestContext#trackedObjects",
      "reason": "The package declares trackedObjects read-only. Each context has one TrackedObjects that the runtime makes; a write from a consumer would detach the tracked objects from the context that owns them."
    },
    {
      "uid": "OfficeExtension.ClientObject#context",
      "reason": "The package declares context read-only and types it as RequestContext. The runtime sets the context of a proxy, and a write from a consumer would detach the proxy from its batch. The package has one context class, RequestContext; ClientRequestContext is a type alias of it."
    },
    {
      "uid": "OfficeExtension.ClientObject#isNullObject",
      "reason": "The package declares isNullObject read-only. The runtime sets it after a sync, and a write from a consumer would make a null object look real."
    },
    {
      "uid": "PowerPoint.Shape#type",
      "reason": "The enum leaves out the one value that names a trademarked feature. The file stores that content as a diagram (dgm:), and the package reports it as Diagram. Every other value matches, and compat:report does not count this read-only member."
    },
    {
      "uid": "PowerPoint.PlaceholderFormat#containedType",
      "reason": "The enum leaves out the one value that names a trademarked feature. The file stores that content as a diagram (dgm:), and the package reports it as Diagram. Every other value matches, and compat:report does not count this read-only member."
    },
    {
      "uid": "PowerPoint.PlaceholderFormat#type",
      "reason": "The enum leaves out the one value that names a trademarked feature. The file stores that content as a diagram (dgm:), and the package reports it as Diagram. Every other value matches, and compat:report does not count this read-only member."
    }
  ]
}
